rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isStaff() {
      return hasRole('staff') || isAdmin();
    }

    function isStudent() {
      return hasRole('student') || isStaff();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Institutions & Dining Halls
    match /institutions/{institutionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /dining_halls/{hallId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 3. Food Items & Menus
    match /food_items/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    match /menus/{menuId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // 4. Meal Sessions & Intentions (Student RSVPs)
    match /meal_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    match /meal_responses/{responseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.student_id == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.student_id == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.student_id == request.auth.uid || isAdmin());
    }

    // 5. Kitchen Operations (Prep, Consumption, Waste)
    match /food_preparation/{prepId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    match /food_consumption/{consumptionId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    match /food_waste/{wasteId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    match /waste_reasons/{reasonId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // 6. Student Feedback & Ratings
    match /feedback/{feedbackId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.student_id == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.student_id == request.auth.uid);
    }

    // 7. AI Predictions & Recommendations
    match /predictions/{predId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    match /recommendations/{recId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 8. Notifications & Alerts
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // 9. Reports & System Settings
    match /reports/{reportId} {
      allow read, write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
